<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <UseMicrosoftTestingPlatformRunner>true</UseMicrosoftTestingPlatformRunner>
    <NoWarn>$(NoWarn);CA1707;CA1515;CA2007;CA1062;CA1861;CA1305;CA1307;CA1310</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="xunit.v3" Version="4.0.2" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../../src/Erp.Core/Erp.Core.csproj" />
    <ProjectReference Include="../../src/Erp.Api/Erp.Api.csproj" />
  </ItemGroup>
</Project>
